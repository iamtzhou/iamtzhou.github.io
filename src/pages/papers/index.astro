---
import { getCollection } from 'astro:content';
import EntryRow from '../../components/EntryRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished, sitePath } from '../../lib/content';

const papers = (await getCollection('papers')).filter(isPublished).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Papers" description="Publications and research manuscripts.">
  <header class="archive-header wrap">
    <h1>Papers</h1>
  </header>
  <section class="archive-list wrap" aria-label="Papers">
    {papers.length > 0 ? papers.map((paper) => <EntryRow href={sitePath(`/papers/${paper.id}/`)} meta={`${paper.data.year} · ${paper.data.venue}`} title={paper.data.title} summary={paper.data.summary} draft={paper.data.draft} />) : <p class="empty-state">Nothing here yet.</p>}
  </section>
</BaseLayout>
