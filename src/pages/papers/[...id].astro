---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';
import { isPublished } from '../../lib/content';

export async function getStaticPaths() {
  const papers = (await getCollection('papers')).filter(isPublished);
  return papers.map((paper) => ({ params: { id: paper.id }, props: { paper } }));
}

interface Props { paper: CollectionEntry<'papers'> }
const { paper } = Astro.props;
const { Content } = await render(paper);
---

<DetailLayout title={paper.data.title} description={paper.data.summary} kicker="Paper" backHref="/papers/" backLabel="All papers" metadata={[String(paper.data.year), paper.data.venue, paper.data.authors.join(' · ')]} links={paper.data.links} draft={paper.data.draft}>
  <Content />
</DetailLayout>
