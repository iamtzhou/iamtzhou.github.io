---
import { getCollection } from 'astro:content';
import EntryRow from '../../components/EntryRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byProjectPeriodDescending, formatProjectPeriod, isPublished, sitePath } from '../../lib/content';

const projects = (await getCollection('projects')).filter(isPublished).sort(byProjectPeriodDescending);
---

<BaseLayout title="Projects" description="Selected systems, experiments, and engineering work.">
  <header class="archive-header wrap">
    <h1>Projects</h1>
  </header>
  <section class="archive-list wrap" aria-label="Projects">
    {projects.map((project) => <EntryRow href={sitePath(`/projects/${project.id}/`)} meta={formatProjectPeriod(project.data.startDate, project.data.endDate)} title={project.data.title} summary={project.data.summary} tags={project.data.tags} draft={project.data.draft} />)}
  </section>
</BaseLayout>
