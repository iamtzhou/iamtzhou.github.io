---
import '../styles/global.css';
import { getProfile, sitePath } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  shareImage?: boolean;
  homePage?: boolean;
}

const {
  title,
  description = 'Personal academic and technical homepage.',
  shareImage = true,
  homePage = false,
} = Astro.props;
const profile = await getProfile();
const pageTitle = title ? `${title} — ${profile.data.name}` : `${profile.data.name}'s Homepage`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = new URL(sitePath('/og.png'), Astro.site);
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImageUrl} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImageUrl} />}
    <title>{pageTitle}</title>
  </head>
  <body class={homePage ? 'home-page' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href={sitePath('/')} aria-label="Home">Home</a>
      <nav aria-label="Primary navigation">
        <a href={sitePath('/publications/')} aria-current={isCurrent(sitePath('/publications/')) ? 'page' : undefined}>Publications</a>
        <a href={sitePath('/projects/')} aria-current={isCurrent(sitePath('/projects/')) ? 'page' : undefined}>Projects</a>
        <a href={sitePath('/articles/')} aria-current={isCurrent(sitePath('/articles/')) ? 'page' : undefined}>Writing</a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
          <svg data-sun xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg data-moon xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    {!homePage && (
      <footer class="site-footer wrap">
        <span>{profile.data.name}'s Homepage</span>
        <a href="#main">Back to top ↑</a>
      </footer>
    )}
  <script>
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  </script>

  <!-- DEBUG COLOR PANEL (remove after tuning) -->
  <div id="debug-color" style="position:fixed;bottom:16px;right:16px;z-index:999;display:flex;gap:6px;align-items:center;padding:8px 12px;background:rgba(128,128,128,.85);border-radius:8px;font:12px/1 monospace;color:#fff;backdrop-filter:blur(4px)">
    <label>R<input type="number" min="0" max="255" id="dbg-r" style="width:48px"></label>
    <label>G<input type="number" min="0" max="255" id="dbg-g" style="width:48px"></label>
    <label>B<input type="number" min="0" max="255" id="dbg-b" style="width:48px"></label>
    <button id="dbg-apply" style="cursor:pointer">Apply</button>
    <button id="dbg-reset" style="cursor:pointer">Reset</button>
  </div>
  <script is:inline>
    (function () {
      var html = document.documentElement;
      var theme = html.getAttribute('data-theme') || 'light';
      var STORE_KEY = 'dbg-paper-' + theme;
      var saved = localStorage.getItem(STORE_KEY);
      var defaults = { light: [243, 241, 235], dark: [22, 20, 15] };

      function apply (r, g, b) {
        html.style.setProperty('--paper', 'rgb(' + r + ',' + g + ',' + b + ')');
      }

      function getEl (id) { return document.getElementById(id); }

      function setInputs (r, g, b) {
        getEl('dbg-r').value = r;
        getEl('dbg-g').value = g;
        getEl('dbg-b').value = b;
      }

      if (saved) {
        var c = JSON.parse(saved);
        apply(c[0], c[1], c[2]);
        setInputs(c[0], c[1], c[2]);
      } else {
        var d = defaults[theme];
        setInputs(d[0], d[1], d[2]);
      }

      getEl('dbg-apply').addEventListener('click', function () {
        var r = +getEl('dbg-r').value;
        var g = +getEl('dbg-g').value;
        var b = +getEl('dbg-b').value;
        apply(r, g, b);
        localStorage.setItem(STORE_KEY, JSON.stringify([r, g, b]));
      });

      getEl('dbg-reset').addEventListener('click', function () {
        var d = defaults[theme];
        html.style.removeProperty('--paper');
        setInputs(d[0], d[1], d[2]);
        localStorage.removeItem(STORE_KEY);
      });
    })();
  </script>
  <!-- END DEBUG -->
  </body>
</html>
