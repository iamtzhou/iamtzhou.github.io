---
import '../styles/global.css';
import { getProfile, sitePath } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  shareImage?: boolean;
  homePage?: boolean;
}

const {
  title,
  description = 'Personal academic and technical homepage.',
  shareImage = true,
  homePage = false,
} = Astro.props;
const profile = await getProfile();
const pageTitle = title ? `${title} — ${profile.data.name}` : `${profile.data.name}'s Homepage`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImageUrl = new URL(sitePath('/og.png'), Astro.site);
const homeUrl = new URL(sitePath('/'), Astro.site);
const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const sameAs = profile.data.links.github ? [profile.data.links.github] : [];
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${homeUrl.href}#person`,
  name: profile.data.name,
  ...(profile.data.nameZh ? { alternateName: profile.data.nameZh } : {}),
  url: homeUrl.href,
  description: profile.data.summary,
  jobTitle: profile.data.role,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: profile.data.affiliation,
  },
  homeLocation: {
    '@type': 'Place',
    name: profile.data.location,
  },
  knowsAbout: profile.data.interests,
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
const personJsonLdJson = JSON.stringify(personJsonLd).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImageUrl} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImageUrl} />}
    {homePage && <script is:inline type="application/ld+json" set:html={personJsonLdJson}></script>}
    <title>{pageTitle}</title>
  </head>
  <body class={homePage ? 'home-page' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href={sitePath('/')} aria-label="Home">Home</a>
      <nav aria-label="Primary navigation">
        <a href={sitePath('/publications/')} aria-current={isCurrent(sitePath('/publications/')) ? 'page' : undefined}>Publications</a>
        <a href={sitePath('/projects/')} aria-current={isCurrent(sitePath('/projects/')) ? 'page' : undefined}>Projects</a>
        <a href={sitePath('/articles/')} aria-current={isCurrent(sitePath('/articles/')) ? 'page' : undefined}>Writing</a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
          <svg data-sun xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg data-moon xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    {!homePage && (
      <footer class="site-footer wrap">
        <span>{profile.data.name}'s Homepage</span>
        <a href="#main">Back to top ↑</a>
      </footer>
    )}
  <script>
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  </script>
  <script is:inline>
    (function () {
      // Original Shiki color → [light (on #e2dcd6), dark (on #2d2525)]
      var map = {
        '#D73A49': ['#9b1b30', '#f0a0a8'],  // keyword
        '#6F42C1': ['#5c1f8a', '#c9a0e8'],  // function
        '#24292E': ['#1a1714', '#e0d8cc'],  // text
        '#005CC5': ['#004089', '#90b8f8'],  // number/constant
        '#032F62': ['#0a5228', '#90d8a8'],  // string
        '#6A737D': ['#6b6358', '#9a9080'],  // comment
        '#22863A': ['#0d5c1a', '#7ee08c'],  // string alt
        '#B31D28': ['#8b1520', '#f5a0a8'],  // emphasis
        '#E36209': ['#b34d00', '#f0b070'],  // special
        '#F97583': ['#9b1b30', '#f97583'],  // keyword (dark origin)
        '#B392F0': ['#5c1f8a', '#b392f0'],  // function (dark origin)
        '#E1E4E8': ['#1a1714', '#e1e4e8'],  // text (dark origin)
        '#79B8FF': ['#004089', '#79b8ff'],  // number (dark origin)
        '#9ECBFF': ['#0a5228', '#9ecbff'],  // string (dark origin)
      };
      var ready = false;

      function apply () {
        var dark = document.documentElement.getAttribute('data-theme') === 'dark';
        var bg = dark ? '#2d2525' : '#e2dcd6';
        var idx = dark ? 1 : 0;
        document.querySelectorAll('pre').forEach(function (el) {
          el.style.setProperty('background-color', bg, 'important');
          el.querySelectorAll('span').forEach(function (span) {
            if (!ready) {
              var m = (span.getAttribute('style') || '').match(/color:\s*(#[0-9A-Fa-f]{6})/i);
              if (m) span.setAttribute('data-oc', m[1].toUpperCase());
            }
            var oc = span.getAttribute('data-oc');
            if (oc && map[oc]) span.style.setProperty('color', map[oc][idx], 'important');
          });
        });
        document.querySelectorAll(':not(pre) > code').forEach(function (el) {
          el.style.setProperty('background-color', bg, 'important');
        });
        ready = true;
      }

      apply();
      var btn = document.querySelector('[data-theme-toggle]');
      btn && btn.addEventListener('click', function () { setTimeout(apply, 0); });
    })();
  </script>

  </body>
</html>
